# ./start.sh creates and loads the local Supabase values automatically.
# Start with an empty file for a local Brepia installation.

# Optional: identify the existing Supabase account that should become Brepia's
# first administrator. If unset, the first local account can be bootstrapped
# when the local account policy allows it.
# BREPIA_ADMIN_EMAIL="admin@example.com"

# Optional SSO provider and external account-management page.
# VITE_SSO_PROVIDER="custom:my-idp"

# VITE_ACCOUNT_URL="https://accounts.example.com/account"

# Optional hosted AI provider credentials. Brepia works without them; providers
# can also be configured later in the Brepia settings UI.
# ANTHROPIC_API_KEY="<Anthropic API key>"
# OPENAI_API_KEY="<OpenAI API key>"
# OPENROUTER_API_KEY="<OpenRouter API key>"
# GOOGLE_API_KEY="<Google AI API key>"

# Custom provider credentials are encrypted server-side. ./start.sh creates a
# persistent local 256-bit key automatically when this is unset. For managed
# deployments, provide a stable 32-byte hex key and keep it secret.
# BREPIA_CREDENTIAL_ENCRYPTION_KEY="<64 hex characters>"

# Optional hosted Creative 3D provider.
# VITE_BREPIA_CREATIVE_MESH_PROVIDERS="fal"
# FAL_KEY="<Fal API Key>"

# Optional externally managed OpenCode server. Otherwise ./start.sh continues
# without OpenCode or starts it automatically when the CLI is installed.
# OPENCODE_BASE_URL="https://opencode.example.com"
# OPENCODE_SERVER_USERNAME="opencode"
# OPENCODE_SERVER_PASSWORD="<OpenCode password>"

# Engineering-only local AI runtime options. Keep local endpoints on loopback;
# setup.sh never downloads models or writes credentials.
# BREPIA_LLAMA_SWAP_URL="http://127.0.0.1:8080"
# BREPIA_LLAMA_SWAP_CONFIG=".brepia/llama-swap/config.yaml"
# BREPIA_LLAMA_CPP_BACKEND="auto"  # auto, cpu, cuda or vulkan
# BREPIA_LLAMA_CPP_SOURCE_DIR="$HOME/.local/share/brepia/llama.cpp"
