{
  "name": "Brepia Viewer - GitHub URL import preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci --no-audit --no-fund",
  "postStartCommand": "bash -lc 'nohup ./start.sh > /tmp/brepia-url-import-preview.log 2>&1 < /dev/null & echo $! > /tmp/brepia-url-import-preview.pid'",
  "forwardPorts": [8005],
  "portsAttributes": {
    "8005": {
      "label": "Brepia Viewer - Import from URL test",
      "onAutoForward": "openBrowserOnce",
      "protocol": "http"
    }
  }
}
